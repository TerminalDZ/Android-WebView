<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules. Mirrors backup_rules.xml. Cloud backup
    and device-to-device transfer both honor these rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="purchase_prefs.xml" />
        <exclude domain="sharedpref" path="rate_prefs.xml" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="iba_webview.db" />
        <exclude domain="file" path="auth_token" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="auth_token" />
    </device-transfer>
</data-extraction-rules>
